# FRONTEND: public configuration only. Never place provider API keys in VITE_*.
# Leave empty for the existing local-response mode on the public site.
# The private Render preview has its own test page and must not be wired here.
VITE_ARCHIAGENT_API_URL=

# Public Formspree form identifier (not an API secret).
VITE_FORMSPREE_ID=your_form_id_here

# Configure OPENAI_API_KEY only in the backend host's secret settings.
# See backend/render/README.md for the preproduction setup.
