# ============================================
# CONFIGURATION LLM POUR ARCHIAAGENT
# ============================================

# Provider: 'openai', 'anthropic', ou 'local'
VITE_LLM_PROVIDER=local

# Clé API OpenAI (si provider = openai)
# Obtenir une clé sur: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-api-key-here

# Clé API Anthropic Claude (si provider = anthropic)
# Obtenir une clé sur: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your-api-key-here

# Modèle à utiliser
# OpenAI: gpt-4, gpt-3.5-turbo, gpt-4-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
VITE_LLM_MODEL=gpt-3.5-turbo

# ============================================
# CONFIGURATION FORMSPREE POUR FORMULAIRE DE CONTACT
# ============================================

# Form ID Formspree
# 1. Créez un compte gratuit sur: https://formspree.io/
# 2. Créez un nouveau formulaire
# 3. Copiez votre Form ID (exemple: xdkobqpg)
# 4. Voir CONFIGURATION-FORMSPREE.md pour le guide complet
VITE_FORMSPREE_ID=your_form_id_here
